                        </li>
                    </ul>
                </ul>
            </nav>
        </header>
        {{ content | safe }}
        <section>
            <nav class="main-menu">
                <ul>
                    <li><a href="/contact/" {% if page.url=='/contact/' %} class="active" {% endif %}>contact</a></li>
                    <li><a href="/bio/" {% if page.url=='/bio/' %} class="active" {% endif %}>bio</a></li>
                </ul>
            </nav>
            <nav class="extra-menu">
