            <p>[online gezet door
                <a target="_blank" href="https://potloodgum.com">potloodgum]</a>
            </p>
        </section>

        {% if page.url == '/' %}
        <a href="https://www.tzum.info/2025/12/recensie-roelof-schipper-bleke-gesp-beige-zoom/" target="_blank"
            style="position:relative;">
            <img src="/img/afb2.jpg" alt="Recensie afb 2" style="max-width: 450px; margin-bottom: 10px; float:left; ">

            <a href="https://www.tzum.info/2025/12/recensie-roelof-schipper-bleke-gesp-beige-zoom/"
                style="position:absolute; right:780px; width:120px;"
                target="_blank">https://www.tzum.info/2025/12/recensie-roelof-schipper-bleke-gesp-beige-zoom/</a>
            <img src="/img/afb1.jpg" alt="Recensie afb 1"
                style="max-width: 350px; margin-bottom: 10px;  float:right; margin-right:180px;">
        </a>
        {% endif %}

    </main>
