<!DOCTYPE html>
<html lang="nl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.bunny.net">
    <link href="https://fonts.bunny.net/css?family=eb-garamond:400,400i,500,500i,600,600i,700,700i,800,800i"
        rel="stylesheet" />
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <main>
        <header>
            <nav class="main-menu">
                <ul>
                    <li>
                        <a href="/">roelof schipper</a>
                    </li>
                    <ul class="sub-menu">
                        <li>
                            <a href="/bleke-gesp-beige-zoom">
                                debuut / ‘bleke gesp, beige zoom’ +
